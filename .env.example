# Threat Intelligence & AI Configuration Template for SIH IronPulse (Role 1)
# Copy to .env and supply your keys

THREAT_INTELLIGENCE_ENABLED=true
AI_FORENSIC_ENABLED=true

# URL Scanning (urlscan.io)
URLSCAN_API_KEY=

# VirusTotal v3 (virustotal.com)
VIRUSTOTAL_API_KEY=

# AbuseIPDB v2 (abuseipdb.com)
ABUSEIPDB_API_KEY=

# NVIDIA NIM Nemotron LLM (integrate.api.nvidia.com)
NEMOTRONS_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Google Gemini AI (generativelanguage.googleapis.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# IP Geolocation & ASN Enrichment (ipinfo.io)
GEOLOCATION_API_KEY=
IPINFO_TOKEN=

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Strong-Password-Here

# Role 4 API Authentication
API_KEY=dev-key

# Safe CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Query Safety Bounds
DEFAULT_GRAPH_DEPTH=2
MAX_GRAPH_DEPTH=4
DEFAULT_GRAPH_LIMIT=50
MAX_GRAPH_LIMIT=100

# Campaign Clustering Weights (Sum to 1.0)
WEIGHT_IOC_OVERLAP=0.35
WEIGHT_INFRA_OVERLAP=0.30
WEIGHT_SUBJECT_SIMILARITY=0.15
WEIGHT_TEMPORAL=0.10
WEIGHT_BEHAVIOR=0.10

# Attribution Confidence Weights (Sum to 1.0)
CONF_WEIGHT_INFRA=0.35
CONF_WEIGHT_TEMPORAL=0.25
CONF_WEIGHT_BEHAVIOR=0.25
CONF_WEIGHT_CONTENT=0.15

# =========================================================
# Threat Intelligence & AI Enrichment (Opt-in)
# =========================================================

# Set to "true" to enable external API lookups during analysis
THREAT_INTELLIGENCE_ENABLED=false

# IP Geolocation (Required for the 3D map to accurately plot origin)
# Get a free key at https://ipinfo.io
IPINFO_TOKEN=

# VirusTotal
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BACKUP_API_KEY=

# URLScan
URLSCAN_API_KEY=

# AbuseIPDB
ABUSEIPDB_API_KEY=

# AI Language Models for Intent Classification

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Nvidia Nemotron (optional)
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

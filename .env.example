# Optional threat intelligence APIs. Leave empty to receive explicit not_configured states.
THREAT_INTELLIGENCE_ENABLED=true
NEO4J_ENABLED=false
ML_MODEL_ENABLED=false
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=
PHISHTANK_API_KEY=
PHISHTANK_ENABLED=false
IPINFO_TOKEN=

# Optional Neo4j graph persistence. JSON graph fallback always remains available.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional local OpenPhish feed (one URL per line). No feed is downloaded automatically.
OPENPHISH_FEED_PATH=

# Enable only when domain DNS/RDAP enrichment is approved for the environment.
NETWORK_ENRICHMENT_ENABLED=false
